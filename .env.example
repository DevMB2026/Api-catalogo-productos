# Copia este archivo a .env y rellena los valores. NO subas .env al repositorio.

# --- Base de datos ---
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/catalogo

# --- Servidor ---
PORT=4000

# --- Cloudinary (Etapa D) ---
# Se obtienen en el dashboard de Cloudinary -> Account Details.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- Almacenamiento de imágenes ---
# "cloudinary" (actual) o "r2" (Cloudflare R2). Cambiar a r2 solo cuando la migración esté probada.
STORAGE_PROVIDER=cloudinary
# R2: Cloudflare -> R2 -> tu bucket -> Settings / Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dominio público del bucket, sin barra final (ej. https://img.prezenza.com)
R2_PUBLIC_URL=

# --- Seguridad (Etapa E) ---
# Cadena larga y aleatoria. Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=7d
# Dominios autorizados para consumir la API desde el navegador (separados por coma, sin espacios).
ALLOWED_ORIGINS=http://localhost:3000,https://fitbefresh.com,https://prezenza.com,https://lacasadelachamarra.com,https://lacasadelaplayera.com,https://uniformesqro.com,https://uniformesmty.mx,https://befreshsecurity.com
